<?xml version="1.0" encoding="utf-8"?>
<!--
  Themed-icon layer (Android 13+). The launcher recolours this against the user's wallpaper
  palette, so it must be a flat single-tone silhouette: no background, and no per-stroke alpha, or
  the tinted result loses the middle stroke entirely. Geometry otherwise matches
  ic_launcher_foreground.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M38,38 L66,38"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="9"
        android:strokeLineCap="round" />
    <path
        android:pathData="M46,54 L70,54"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="9"
        android:strokeLineCap="round" />
    <path
        android:pathData="M38,70 L58,70"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="9"
        android:strokeLineCap="round" />
</vector>
